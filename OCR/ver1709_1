"""
Module: ocr_engine.py
Description: Optimized OCR Extraction Pipeline for Text & LayoutLMv3-Normalized Bounding Boxes
Stack: paddleocr / PaddleOCR, OpenCV, NumPy, PyTorch (CUDA / MPS / CPU)

Provides:
- Robust text token extraction from flattened/dewarped document images.
- LayoutLMv3 coordinate normalization ([0, 1000] scale integer bounding boxes).
- Top-to-bottom, left-to-right reading order sorting and line grouping.
- Mixed orientation correction and confidence estimation.
"""

from __future__ import annotations

import logging
import time
from dataclasses import asdict, dataclass
from typing import Any, Dict, List, Optional, Tuple, Union

import cv2
import numpy as np

logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(name)s: %(message)s")
logger = logging.getLogger("OCREngine")


@dataclass
class OCRToken:
    """Represents an extracted text token with absolute and LayoutLM-normalized coordinates."""
    text: str
    confidence: float                  # 0.0 to 1.0
    bbox_pixel: List[int]              # [x0, y0, x1, y1] in image pixel space
    bbox_normalized: List[int]         # [x0, y0, x1, y1] scaled to [0, 1000] for LayoutLMv3
    polygon: Optional[List[List[int]]] = None  # 4-point quadrilateral
    line_index: int = 0
    reading_order: int = 0

    def to_dict(self) -> Dict[str, Any]:
        return asdict(self)


class DocumentOCREngine:
    """
    High-accuracy multilingual OCR engine with spatial coordinate normalization.
    Supports PaddleOCR and EasyOCR backends with correct framework GPU handling.
    """

    def __init__(
        self,
        backend: str = "paddleocr",
        languages: Optional[List[str]] = None,
        gpu: bool = True,
        confidence_threshold: float = 0.45,
    ):
        self.backend = backend.lower()
        self.languages = languages or ["en", "hi"]
        self.confidence_threshold = confidence_threshold
        self.use_gpu = False
        self.device = "cpu"

        # Correct framework-specific GPU checks
        if gpu:
            if self.backend == "paddleocr":
                try:
                    import paddle
                    if paddle.device.is_compiled_with_cuda():
                        self.use_gpu = True
                        self.device = "cuda"
                except ImportError:
                    logger.warning("PaddlePaddle not installed or not CUDA-enabled.")
            
            elif self.backend == "easyocr":
                try:
                    import torch
                    if torch.cuda.is_available():
                        self.use_gpu = True
                        self.device = "cuda"
                    elif torch.backends.mps.is_available():
                        self.use_gpu = True
                        self.device = "mps"
                except ImportError:
                    logger.warning("PyTorch not installed.")

        # TODO: add AMD (ROCm) and Intel (OpenVINO) GPU support

        logger.info(f"Initializing OCR engine [{self.backend}] on device: {self.device} for languages: {self.languages}")

        self._reader = None
        self._init_backend()

    def _init_backend(self) -> None:
        """Loads backend OCR weights into memory."""
        if self.backend == "easyocr":
            try:
                import easyocr
                self._reader = easyocr.Reader(
                    self.languages,
                    gpu=self.use_gpu,
                    verbose=False
                )
                logger.info("EasyOCR model initialized successfully.")
            except ImportError:
                logger.warning("easyocr not installed; falling back to fallback mock OCR.")
                self._reader = None

        elif self.backend == "paddleocr":
            try:
                from paddleocr import PaddleOCR
                # PaddleOCR expects a primary string for lang. 'hi' includes English alphanumerics.
                primary_lang = "hi" if "hi" in self.languages else self.languages[0]
                self._reader = PaddleOCR(
                    use_angle_cls=True,
                    lang=primary_lang,
                    use_gpu=self.use_gpu,
                    show_log=False
                )
                logger.info("PaddleOCR model initialized successfully.")
            except ImportError:
                logger.warning("paddleocr not installed; falling back to fallback mock OCR.")
                self._reader = None

    @staticmethod
    def normalize_bbox(
        box: Union[List[int], Tuple[int, int, int, int]],
        width: int,
        height: int,
    ) -> List[int]:
        """
        Normalizes pixel coordinates [x0, y0, x1, y1] to [0, 1000] scale
        strictly required by LayoutLMv2 / LayoutLMv3 models.
        """
        x0, y0, x1, y1 = box
        w = max(width, 1)
        h = max(height, 1)

        norm_x0 = int(np.clip(round((min(x0, x1) / w) * 1000), 0, 1000))
        norm_y0 = int(np.clip(round((min(y0, y1) / h) * 1000), 0, 1000))
        norm_x1 = int(np.clip(round((max(x0, x1) / w) * 1000), 0, 1000))
        norm_y1 = int(np.clip(round((max(y0, y1) / h) * 1000), 0, 1000))

        # Enforce non-zero area
        if norm_x1 <= norm_x0:
            norm_x1 = min(1000, norm_x0 + 1)
        if norm_y1 <= norm_y0:
            norm_y1 = min(1000, norm_y0 + 1)

        return [norm_x0, norm_y0, norm_x1, norm_y1]

    def _sort_reading_order(self, tokens: List[OCRToken]) -> List[OCRToken]:
        """
        Sorts bounding boxes into natural document reading order (top-to-bottom, left-to-right).
        Uses dynamic line tolerance based on the actual height of extracted text.
        """
        if not tokens:
            return []

        # Dynamic Line Tolerance: calculate 40% of the median text height
        median_h = np.median([t.bbox_pixel[3] - t.bbox_pixel[1] for t in tokens])
        line_tolerance_px = max(int(median_h * 0.4), 5) # Ensure at least 5px tolerance

        # Sort primarily by y0
        sorted_by_y = sorted(tokens, key=lambda t: t.bbox_pixel[1])

        lines: List[List[OCRToken]] = []
        current_line: List[OCRToken] = []
        current_line_y = sorted_by_y[0].bbox_pixel[1]

        for token in sorted_by_y:
            token_y = token.bbox_pixel[1]
            if abs(token_y - current_line_y) <= line_tolerance_px:
                current_line.append(token)
            else:
                if current_line:
                    current_line.sort(key=lambda t: t.bbox_pixel[0])
                    lines.append(current_line)
                current_line = [token]
                current_line_y = token_y

        if current_line:
            current_line.sort(key=lambda t: t.bbox_pixel[0])
            lines.append(current_line)

        # Flatten and assign line index and sequential reading order
        ordered_tokens: List[OCRToken] = []
        global_order = 0
        for line_idx, line in enumerate(lines):
            for token in line:
                token.line_index = line_idx
                token.reading_order = global_order
                global_order += 1
                ordered_tokens.append(token)

        return ordered_tokens

    def extract_text_and_boxes(
        self,
        image: np.ndarray,
        preprocess: bool = False,
    ) -> Tuple[List[OCRToken], float]:
        """
        Runs OCR on the given image and extracts tokens with normalized LayoutLM bounding boxes.
        Returns: (tokens, execution_time_ms)
        """
        t0 = time.perf_counter()
        img_h, img_w = image.shape[:2]
        extracted_tokens: List[OCRToken] = []

        if preprocess:
            gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY) if len(image.shape) == 3 else image
            # Gaussian blur prevents background noise/paper grain from becoming black dots during thresholding
            blurred = cv2.GaussianBlur(gray, (5, 5), 0)
            binary = cv2.adaptiveThreshold(
                blurred, 255, cv2.ADAPTIVE_THRESH_GAUSSIAN_C, cv2.THRESH_BINARY, 21, 10
            )
            image = cv2.cvtColor(binary, cv2.COLOR_GRAY2BGR)

        if self._reader is not None:
            if self.backend == "easyocr":
                raw_results = self._reader.readtext(image)
                for poly, text, conf in raw_results:
                    if conf < self.confidence_threshold:
                        continue
                    clean_text = text.strip()
                    if not clean_text:
                        continue

                    poly_arr = np.array(poly, dtype=np.int32)
                    x0, y0 = int(np.min(poly_arr[:, 0])), int(np.min(poly_arr[:, 1]))
                    x1, y1 = int(np.max(poly_arr[:, 0])), int(np.max(poly_arr[:, 1]))

                    extracted_tokens.append(OCRToken(
                        text=clean_text,
                        confidence=float(conf),
                        bbox_pixel=[x0, y0, x1, y1],
                        bbox_normalized=self.normalize_bbox([x0, y0, x1, y1], img_w, img_h),
                        polygon=poly_arr.tolist(),
                    ))

            elif self.backend == "paddleocr":
                result = self._reader.ocr(image, cls=True)
                if result and result[0]:
                    for line in result[0]:
                        poly, (text, conf) = line[0], line[1]
                        if conf < self.confidence_threshold:
                            continue
                        
                        poly_arr = np.array(poly, dtype=np.int32)
                        x0, y0 = int(np.min(poly_arr[:, 0])), int(np.min(poly_arr[:, 1]))
                        x1, y1 = int(np.max(poly_arr[:, 0])), int(np.max(poly_arr[:, 1]))

                        extracted_tokens.append(OCRToken(
                            text=text.strip(),
                            confidence=float(conf),
                            bbox_pixel=[x0, y0, x1, y1],
                            bbox_normalized=self.normalize_bbox([x0, y0, x1, y1], img_w, img_h),
                            polygon=poly_arr.tolist(),
                        ))
        else:
            logger.info("Using heuristic text localization fallback (no backend loaded).")
            # ... fallback code omitted for brevity but should yield mock tokens ...

        ordered_tokens = self._sort_reading_order(extracted_tokens)
        elapsed_ms = (time.perf_counter() - t0) * 1000.0

        logger.info(f"OCR extracted {len(ordered_tokens)} tokens in {elapsed_ms:.2f}ms.")
        return ordered_tokens, elapsed_ms


if __name__ == "__main__":
    dummy = np.zeros((400, 600, 3), dtype=np.uint8)
    cv2.putText(dummy, "NET QUANTITY: 500g", (50, 100), cv2.FONT_HERSHEY_SIMPLEX, 0.8, (255, 255, 255), 2)
    cv2.putText(dummy, "MRP Rs. 99.00 (INCL TAX)", (50, 160), cv2.FONT_HERSHEY_SIMPLEX, 0.8, (255, 255, 255), 2)

    engine = DocumentOCREngine(backend="paddleocr")
    tokens, ms = engine.extract_text_and_boxes(dummy)
    print(f"Extracted {len(tokens)} tokens in {ms:.2f}ms")
    for t in tokens:
        print(f" - '{t.text}' | BoxNorm: {t.bbox_normalized} | Conf: {t.confidence:.2f}")
